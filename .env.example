# IMOU Open Platform credentials. Never commit real values.
IMOU_APP_ID=
IMOU_APP_SECRET=

# Select the data-center hostname shown in the IMOU account information.
# Examples include openapi-sg.easy4ip.com, openapi-fk.easy4ip.com, and
# openapi-or.easy4ip.com.
IMOU_API_HOST=

# Current IMOU documentation uses hmac-sha256. Use md5 only when an older
# data-center endpoint explicitly rejects the current signature format.
IMOU_SIGNING_ALGORITHM=hmac-sha256

# Downloaded-video identity and destination.
VABS_PROJECT=
VABS_BRANCH=
VABS_CAMERA_NAME=
VABS_VIDEO_ROOT=
